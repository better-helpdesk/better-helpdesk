# Copy to .env.local for `pnpm dev`. On Divio, DATABASE_URL comes from the
# database service and the rest is set under Env Variables.
DATABASE_URL=postgres://postgres@localhost:5432/helpdesk_site

# The origin visitors open. The handler refuses mutations from any other
# origin, and the Open Graph image links are built from it.
SITE_URL=http://localhost:3000

# Signs the session cookies of the agents who sign in at /login/. Generate one
# per environment with `openssl rand -base64 32`; changing it signs everyone out.
# Accounts are made with `pnpm --filter better-helpdesk-site agent <email> <name>`.
BETTER_AUTH_SECRET=

# Optional. The live demo at /demo, in a database of its own: every quarter
# hour the server empties its helpdesk schema and seeds it again, so never
# point it at DATABASE_URL (the reset refuses to).
# DEMO_DATABASE_URL=postgres://postgres@localhost:5432/helpdesk_demo

# Optional. Without it replies stay in the inbox and nothing is mailed.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Better Helpdesk <hello@example.com>
