# Copy to .env.local. Anything Postgres 14 or newer will do; the demo creates
# its own `helpdesk` schema there.
HELPDESK_DATABASE_URL=postgres://postgres@localhost:5432/helpdesk_demo

# Where this app answers. The handler refuses cross-origin mutations, so this
# has to be the origin you actually open in the browser.
DEMO_URL=http://localhost:3000
